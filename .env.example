# Telegram Bot API
BOT_TOKEN=your_telegram_bot_token

# AITUNNEL (OpenAI-совместимый прокси)
AITUNNEL_API_KEY=sk-aitunnel-xxx
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/

# Опционально:
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512
# MAX_HISTORY_MESSAGES не меньше 2 (пара вопрос-ответ)
MAX_HISTORY_MESSAGES=10
LOG_LEVEL=INFO

# Таймаут одного запроса и число повторов на уровне OpenAI SDK
AITUNNEL_TIMEOUT_SECONDS=60
AITUNNEL_MAX_RETRIES=2

# Максимальная длина одного сообщения Telegram (не более 4096)
MESSAGE_CHUNK_SIZE=4096

# System prompt (пустое значение = без system-сообщения)
SYSTEM_PROMPT=Ты полезный AI-ассистент в Telegram. Отвечай кратко и по делу на языке пользователя, если он не попросил иное.

# Allowlist: Telegram user_id через запятую. Пусто = доступ всем
# ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Минимальный интервал между запросами к модели на одного пользователя (сек). 0 = выкл
RATE_LIMIT_SECONDS=2

# Сохранять историю диалогов на диск между перезапусками
PERSIST_CONTEXT=true
CONTEXT_FILE=data/contexts.json
